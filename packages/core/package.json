{
  "name": "@open-edu/core",
  "version": "0.1.1",
  "private": true,
  "description": "Package loader and validation for Open-Edu",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/widget-catalog-data.json dist/",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@open-edu/logger": "workspace:*",
    "@open-edu/schemas": "workspace:*",
    "zod": "^3.25.76"
  },
  "type": "module"
}
