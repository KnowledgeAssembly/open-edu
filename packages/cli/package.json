{
  "name": "@open-edu/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "edu CLI for Open-Edu",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "edu": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@open-edu/core": "workspace:*",
    "@open-edu/dev-server": "workspace:*",
    "commander": "^12.0.0"
  }
}
