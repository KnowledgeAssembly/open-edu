{
  "type": "exercise",
  "title": "Grid Area Practice",
  "widget": "math.grid-area",
  "config": {
    "description": "Highlight 6 cells to match the area shown.",
    "rows": 5,
    "cols": 5,
    "mode": "area",
    "targetCount": 6,
    "showQuestionArea": true,
    "targetHighlights": [
      { "row": 0, "col": 0 },
      { "row": 0, "col": 1 },
      { "row": 0, "col": 2 },
      { "row": 1, "col": 0 },
      { "row": 1, "col": 1 },
      { "row": 1, "col": 2 }
    ],
    "maxHighlights": 25,
    "showCount": true,
    "interactive": true
  }
}
