# Open-Edu Docker Compose environment (all values optional).
#
# Copy to `.env` in the repo root and fill in what you need:
#   cp .env.example .env
#
# Without any keys everything still works — the AI features degrade gracefully:
#   - Learner: Pipili AI companion chat is unavailable.
#   - Studio:  AI course drafting falls back to templates.

# --- Learner / Pipili + shared LLM config ------------------------------------
# Provider: "openai" or "openrouter" (default: openai)
LLM_PROVIDER=
# Model name (default: gpt-4o-mini)
LLM_MODEL=
# Custom OpenAI-compatible base URL (optional)
LLM_BASE_URL=
# API key for the provider above; falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY
LLM_API_KEY=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# --- Provider fallbacks -------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Studio AI drafting (server-side; optional overrides) ---------------------
OPEN_EDU_STUDIO_LLM_PROVIDER=
OPEN_EDU_STUDIO_LLM_MODEL=
OPEN_EDU_STUDIO_LLM_BASE_URL=
OPEN_EDU_STUDIO_LLM_API_KEY=
