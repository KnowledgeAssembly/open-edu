# AI Companion — LLM configuration
# The API key is managed server-side by the LLM proxy (apps/dev-server).
# The learner app sends prompts to the proxy URL below.

# LLM proxy endpoint URL
# Default: http://localhost:4000/api/llm/chat
# Set this to your dev-server or production proxy URL.
# VITE_LLM_PROXY_URL=http://localhost:4000/api/llm/chat
