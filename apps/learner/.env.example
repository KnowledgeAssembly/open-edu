# AI Companion — LLM Proxy Configuration
# The LLM proxy runs on the same server (POST /api/llm/chat).
# API key is read server-side by the Vite dev server middleware.

# LLM_API_KEY=sk-your-api-key-here

# Provider: "openai" or "openrouter" (default: openai)
# LLM_PROVIDER=openrouter

# Model name (default: gpt-4o-mini)
# LLM_MODEL=openai/gpt-4o-mini

# Custom OpenAI-compatible endpoint (e.g. local Ollama: http://localhost:11434/v1)
# When set, no API key is required. The Chat Completions API is used.
# LLM_BASE_URL=http://localhost:11434/v1

# Override proxy URL (default: /api/llm/chat — same origin)
# Set this if using an external proxy.
# VITE_LLM_PROXY_URL=/api/llm/chat
