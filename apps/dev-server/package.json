{
  "name": "@open-edu/dev-server",
  "version": "0.1.0",
  "private": true,
  "description": "Vite dev server for Open-Edu",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@open-edu/accessibility": "workspace:*",
    "@open-edu/core": "workspace:*",
    "@open-edu/design-system": "workspace:*",
    "@open-edu/llm-config": "workspace:*",
    "@open-edu/rewards": "workspace:*",
    "@open-edu/runtime": "workspace:*",
    "@open-edu/telemetry": "workspace:*",
    "@open-edu/widgets": "workspace:*",
    "@open-edu/workflow": "workspace:*",
    "@open-edu/schemas": "workspace:*",
    "axe-core": "^4.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.1.0",
    "zod": "^3.22.0",
    "@vitejs/plugin-react": "^4.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.5.2",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4"
  },
  "type": "module"
}
