# LLM Proxy Configuration
# These environment variables configure the LLM proxy endpoint
# running on the dev-server (POST /api/llm/chat).

# Provider: "openai" or "openrouter" (default: openai)
# LLM_PROVIDER=openrouter

# Model name (default: gpt-4o-mini)
# LLM_MODEL=openai/gpt-4o-mini

# API key for the selected provider
# The API key is read server-side and never exposed to the client.
# LLM_API_KEY=sk-your-api-key-here

# Max tokens for generation (default: 4096)
# LLM_MAX_TOKENS=4096

# Temperature for generation (default: 0.3)
# LLM_TEMPERATURE=0.3
